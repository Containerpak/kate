{
  "$schema": "https://raw.githubusercontent.com/Containerpak/cpak/v2/schema/manifest-v3.json",
  "manifest_version": "3.0",
  "name": "Kate",
  "description": "A full-featured text editor with projects, sessions and an integrated terminal.",
  "version": "26.08.0",
  "image": "ghcr.io/containerpak/kate@sha256:488326e3803aa1771fa896ce534635fb5d1e380d56150d28b422337428fbb405",
  "binaries": [
    "/usr/bin/kate"
  ],
  "desktop_entries": [
    "/usr/share/applications/org.kde.kate.desktop"
  ],
  "dependencies": [],
  "addons": [
    "github.com/containerpak/sdk-go",
    "github.com/containerpak/sdk-node-lts"
  ],
  "idle_time": 0,
  "override": {
    "socketWayland": true,
    "socketPulseAudio": false,
    "socketSshAgent": true,
    "socketCups": false,
    "socketGpgAgent": true,
    "deviceDri": true,
    "deviceKvm": false,
    "deviceShm": false,
    "deviceAlsa": false,
    "deviceVideo": false,
    "deviceFuse": false,
    "deviceTun": false,
    "deviceUsb": false,
    "deviceAll": false,
    "notification": false,
    "openURI": true,
    "filesystem": [
      {
        "path": "home",
        "access": "read-write"
      }
    ],
    "env": [],
    "network": true,
    "process": false,
    "userNamespaces": false,
    "memoryMaxMB": 0,
    "cpuQuota": 0,
    "pidsMax": 0,
    "asRoot": false
  }
}
